# ──────────────────────────────────────────────
# School ERP — Environment Variables
# Copy this to .env and fill in your values
# ──────────────────────────────────────────────

# ── General ──
NODE_ENV=development
PORT_GATEWAY=4000
PORT_WEB=3000

# ── PostgreSQL ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_erp?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_erp

# ── MongoDB ──
MONGODB_URI=mongodb://localhost:27017/school_erp_logs

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── JWT ──
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# ── NextAuth ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# ── MinIO (S3-compatible storage) ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=school-erp

# ── Email (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── SMS (Twilio) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Payment Gateway ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Services Ports ──
PORT_STUDENT_SERVICE=4001
PORT_STAFF_SERVICE=4002
PORT_ACADEMIC_SERVICE=4003
PORT_FEE_SERVICE=4004
PORT_COMMUNICATION_SERVICE=4005
PORT_ATTENDANCE_SERVICE=4006
PORT_ANALYTICS_SERVICE=5001
PORT_AI_SERVICE=5002
PORT_GO_SERVICE=5003
PORT_NOTIFICATION_ENGINE=6001
PORT_BULK_PROCESSOR=6002
PORT_TIMETABLE_ENGINE=6003
PORT_FILE_SERVICE=6004
