# ──────────────────────────────────────────────
# School ERP — Environment Variables
#
# Copy this file to .env (`copy .env.example .env`) and then run `npm run keygen`
# to generate real secrets + the service-to-service assertion keypair. The
# placeholder values below are REJECTED at boot by @school-erp/config on purpose
# — a missing or placeholder secret must crash the process, not downgrade.
#
# Production uses a secret manager (AWS Secrets Manager / Doppler / sops), never
# a .env file, and NODE_ENV=production skips .env loading entirely.
# ──────────────────────────────────────────────

# ── General ──
NODE_ENV=development
LOG_LEVEL=info
PORT_GATEWAY=4000
PORT_WEB=3000

# ── PostgreSQL ──
# Port: `npm run docker:up` publishes 5432 (docker-compose.dev.yml overrides the
# base compose's 5433). If you run the base docker-compose.yml alone, use 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_erp?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_erp

# ── MongoDB ──
# Still present in docker-compose, but its future is being decided in Phase 7
# (adoption or removal). Do not build new features on it.
MONGODB_URI=mongodb://localhost:27017/school_erp_logs

# ── Redis ──
# Required for the token store (revocation shared across gateway instances)
# before Phase 1. Single-instance dev falls back to an in-memory store.
REDIS_URL=redis://localhost:6379

# ── JWT (user sessions) ──
# Access tokens are 15 minutes; refresh tokens rotate on every use (30 days).
# Generate secrets with: npm run keygen
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ── Service-to-service assertions (ADR-3) ──
# RS256 (RSA-2048) keypair, generated by `npm run keygen`. The gateway holds
# the private key and mints 60-second, audience-bound assertions; every service
# holds only the public key and verifies. There is deliberately no fallback, ever.
INTERNAL_ASSERTION_PRIVATE_KEY=
INTERNAL_ASSERTION_PUBLIC_KEY=
INTERNAL_ASSERTION_TTL_SECONDS=60

# ── Login throttling (identity-service) ──
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_THRESHOLD=10
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=10
# Query the HIBP k-anonymity range API when a password is set. "false" for
# offline installs and tests only.
PASSWORD_BREACH_CHECK=true

# ── CORS allowlist ──
# Comma-separated. `origin: true` (reflect any origin + credentials) is gone.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ── NextAuth ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ── MinIO (S3-compatible storage) ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=school-erp

# ── Email (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── SMS (Twilio, Phase 5 uses a DLT-compliant provider) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Payment Gateway (Phase 4) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Services Ports ──
PORT_STUDENT_SERVICE=4001
PORT_STAFF_SERVICE=4002
PORT_ACADEMIC_SERVICE=4003
PORT_FEE_SERVICE=4004
PORT_COMMUNICATION_SERVICE=4005
PORT_ATTENDANCE_SERVICE=4006
PORT_ANALYTICS_SERVICE=5001
PORT_AI_SERVICE=5002
PORT_GO_SERVICE=5003
PORT_NOTIFICATION_ENGINE=6001
PORT_BULK_PROCESSOR=6002
PORT_TIMETABLE_ENGINE=6003
PORT_FILE_SERVICE=6004
