# ──────────────────────────────────────────────
# School ERP — Environment Variables
#
# Copy this file to .env (`copy .env.example .env`) and then run `npm run keygen`
# to generate real secrets + the service-to-service assertion keypair. The
# placeholder values below are REJECTED at boot by @school-erp/config on purpose
# — a missing or placeholder secret must crash the process, not downgrade.
#
# Production uses a secret manager (AWS Secrets Manager / Doppler / sops), never
# a .env file, and NODE_ENV=production skips .env loading entirely.
# ──────────────────────────────────────────────

# ── General ──
NODE_ENV=development
LOG_LEVEL=info
PORT_GATEWAY=4000
PORT_WEB=3000

# ── PostgreSQL ──
# Port: `npm run docker:up` publishes 5432 (docker-compose.dev.yml overrides the
# base compose's 5433). If you run the base docker-compose.yml alone, use 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_erp?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_erp

# Control plane (Phase 1): the platform-owned registry database (tenants,
# plans, subscriptions). One per deployment; tenant school data stays in
# DATABASE_URL's cluster, one database per school.
CONTROL_PLANE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_erp_control?schema=public

# ── MongoDB: removed (BUILD_PLAN §7.3) ──
# Nothing used it; audit and notification logs live in Postgres
# (`audit_logs`, `notification_logs`). See docs/ops/phase7-decisions.md.

# ── Redis ──
# Required for the token store (revocation shared across gateway instances)
# before Phase 1. Single-instance dev falls back to an in-memory store.
REDIS_URL=redis://localhost:6379

# ── JWT (user sessions) ──
# Access tokens are 15 minutes; refresh tokens rotate on every use (30 days).
# Generate secrets with: npm run keygen
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ── Service-to-service assertions (ADR-3) ──
# RS256 (RSA-2048) keypair, generated by `npm run keygen`. The gateway holds
# the private key and mints 60-second, audience-bound assertions; every service
# holds only the public key and verifies. There is deliberately no fallback, ever.
INTERNAL_ASSERTION_PRIVATE_KEY=
INTERNAL_ASSERTION_PUBLIC_KEY=
INTERNAL_ASSERTION_TTL_SECONDS=60

# ── Login throttling (identity-service) ──
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_THRESHOLD=10
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=10
# Query the HIBP k-anonymity range API when a password is set. "false" for
# offline installs and tests only.
PASSWORD_BREACH_CHECK=true

# ── CORS allowlist ──
# Comma-separated. `origin: true` (reflect any origin + credentials) is gone.
# Browser origins allowed to call the gateway. Add your LAN/production web
# origin(s) here — a mismatch blocks writes in the browser (reads served from
# cache may still render, which makes it look half-broken). No trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ── NextAuth ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ── Platform admin console (Phase 1) ──
# Signs the admin-console session cookie. >= 32 chars: openssl rand -base64 48
ADMIN_CONSOLE_SESSION_SECRET=

# ── MinIO (S3-compatible storage) ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=school-erp

# ── Email (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── SMS (Twilio, Phase 5 uses a DLT-compliant provider) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Payment Gateway (Phase 4) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from the Razorpay dashboard (Settings → Webhooks). Signs
# deliveries; fee-service verifies the HMAC over the raw body (BUILD_PLAN 4.1).
RAZORPAY_WEBHOOK_SECRET=

# ── Services Ports ──
PORT_STUDENT_SERVICE=4001
PORT_STAFF_SERVICE=4002
PORT_ACADEMIC_SERVICE=4003
PORT_FEE_SERVICE=4004
PORT_COMMUNICATION_SERVICE=4005
PORT_ATTENDANCE_SERVICE=4006
PORT_EXAM_SERVICE=4007
PORT_IDENTITY_SERVICE=4010
# First-run setup wizard + branch management (provision-service).
# SETUP_TOKEN: OPTIONAL shared secret for POST /setup. When set, the wizard
# page must send it as `x-setup-token`. Leave unset for a single-school VPS —
# the wizard locks itself permanently after the first successful run.
PORT_PROVISION_SERVICE=4009
SETUP_TOKEN=
PORT_ANALYTICS_SERVICE=5001
PORT_AI_SERVICE=5002
PORT_NOTIFICATION_ENGINE=6001
PORT_BULK_PROCESSOR=6002
PORT_TIMETABLE_ENGINE=6003
PORT_FILE_SERVICE=6004

# ── Tax-invoice supplier identity (Rule 46, CGST Rules 2017) ──
# Printed on every SaaS tax invoice issued by provisioning-service.
# GSTIN must pass checksum validation — convert/renew refuse invalid ones.
SUPPLIER_GSTIN=
SUPPLIER_NAME=
SUPPLIER_ADDRESS=

# ── Messaging providers (BUILD_PLAN 5.1/5.2) — all optional ──
# Meta WhatsApp Cloud API (no BSP middleman needed to start)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta signs webhook callbacks (X-Hub-Signature-256) with this secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# DLT-registered SMS aggregator (MSG91/Kaleyra/Textlocal common REST shape)
SMS_API_BASE=
SMS_API_KEY=
SMS_SENDER_HEADER=
# Generic shared secret for provider delivery callbacks
MESSAGING_WEBHOOK_SECRET=
# Quiet hours (server-local hours) — non-urgent sends wait; urgent bypasses
QUIET_HOURS_START=21
QUIET_HOURS_END=8

# ── FCM push (BUILD_PLAN 5.4) — mobile-app notifications ──
# Google service account with https://www.googleapis.com/auth/firebase.messaging
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Service-account PEM with literal \n escapes (as in the JSON key file)
FCM_PRIVATE_KEY=

# ── Direct peer calls (optional; default http://localhost:4005) ──
# attendance-service → communication-service live absence-alert fire (5.6 #1).
# Needs INTERNAL_ASSERTION_PRIVATE_KEY to mint the peer assertion; without it
# the live fire is skipped and the communication-service morning sweep covers.
COMMUNICATION_SERVICE_URL=http://localhost:4005

# ── Email (BUILD_PLAN 5.3) — exactly ONE provider; both set is refused ──
# AWS SES (SigV4 against the SESv2 SendEmail endpoint)
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# Postmark (server token)
POSTMARK_SERVER_TOKEN=
# Verified sender (either provider refuses unverified From addresses)
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# ── Chat WebSocket hub (Phase 9) ──
# Short-lived connect tickets for the class-room chat WebSocket (openssl rand -hex 32).
# Unset = live chat delivery disabled; clients fall back to polling.
CHAT_TICKET_SECRET=
# Dedicated direct-connect listener for the chat hub (0 disables it).
CHAT_HUB_PORT=4015

# ── Phase 11: gateway rate-limit budgets (requests/minute per identity) ──
# RATE_LIMIT_WRITE_PER_MIN=60
# RATE_LIMIT_READ_PER_MIN=300

# ── Nightly late-fee sweep (fee-service) ──
# Applies each branch's late-fee slabs to overdue invoices once a day.
# Idempotent per (rule, invoice) — safe alongside manual "Apply" from the console.
# LATE_FEE_SWEEP_HOUR is server-local (IST on the deployment box); the catch-up
# window runs the day's sweep late if the service was down at the exact hour.
LATE_FEE_SWEEP_ENABLED=true
LATE_FEE_SWEEP_HOUR=1
LATE_FEE_SWEEP_WINDOW_HOURS=2

# ──────────────────────────────────────────────
# Docker deployment (docker/docker-compose.app.yml) — see docs/ops/DEPLOY.md
# ──────────────────────────────────────────────
# Postgres superuser password (REQUIRED — containers refuse to boot without it)
# POSTGRES_PASSWORD=
# POSTGRES_USER=postgres
# POSTGRES_DB=school_erp
# Public hostname for automatic HTTPS via the Caddy edge (unset = plain :80)
# DOMAIN=erp.yourschools.in
# Host port for the API gateway (direct access without the edge)
# GATEWAY_PORT=4000
# Operator console exposure — loopback-only unless you override it
# ADMIN_CONSOLE_PORT=127.0.0.1:3100
# Browser-side API base for the Next.js builds (inlined at image build time)
# Same-machine Caddy default below; use https://<domain>/api/v1 when DOMAIN is set
# NEXT_PUBLIC_API_URL=/api/v1
